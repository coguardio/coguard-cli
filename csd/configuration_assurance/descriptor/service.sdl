{
  "name" : "CONFIGURATION_ASSURANCE",
  "label" : "Configuration Assurance",
  "description" : "Reports the state of the configuration of this cluster as CoGuard scans it. The service is healthy while the last scan found nothing at or above the severity it is configured to fail on -- by default the High and Critical findings -- and unhealthy while such a finding is not addressed, which is what makes a configuration finding visible in the cluster view of Cloudera Manager rather than only in a report. The CoGuard CLI comes from the COGUARD parcel, which has to be distributed and activated on the host of the Configuration Check role.",
  "version" : "1.1",
  "icon" : "images/icon.png",
  "svgIcon" : "images/icon.svg",
  "runAs" : {
    "user" : "cloudera-scm",
    "group" : "cloudera-scm"
  },
  "maxInstances" : 1,
  "compatibility" : {
    "generation" : 1,
    "cdhVersion" : {
      "min" : "7"
    }
  },
  "parcel" : {
    "repoUrl" : "https://github.com/coguardio/coguard-cli/releases/latest/download/",
    "requiredTags" : [ "coguard" ]
  },
  "parameters" : [
    {
      "name" : "cloudera_manager_url",
      "label" : "Cloudera Manager URL",
      "description" : "The address the scan reads this cluster through, e.g. https://cm.example.com. This is the Cloudera Manager API, so the address has to be reachable from the host the Configuration Check role runs on.",
      "configName" : "cloudera_manager_url",
      "type" : "uri",
      "required" : "true"
    },
    {
      "name" : "cloudera_manager_user",
      "label" : "Cloudera Manager User",
      "description" : "The Cloudera Manager user the scan authenticates as. Read-Only is enough: the scan issues GET requests only.",
      "configName" : "cloudera_manager_user",
      "type" : "string",
      "default" : "coguard",
      "required" : "true"
    },
    {
      "name" : "cloudera_manager_password",
      "label" : "Cloudera Manager Password",
      "description" : "The password of the Cloudera Manager user above. It is stored as a password: the API, the web interface and exports of the configuration show it redacted.",
      "configName" : "cloudera_manager_password",
      "type" : "password",
      "required" : "false"
    },
    {
      "name" : "coguard_user_name",
      "label" : "CoGuard User",
      "description" : "The CoGuard account the scans are made with, i.e. the user name it logs in to the CoGuard portal with.",
      "configName" : "coguard_user_name",
      "type" : "string",
      "default" : ""
    },
    {
      "name" : "coguard_password",
      "label" : "CoGuard Password",
      "description" : "The password of the CoGuard account above. It is stored as a password: the API, the web interface and exports of the configuration show it redacted.",
      "configName" : "coguard_password",
      "type" : "password",
      "required" : "false"
    },
    {
      "name" : "coguard_organization",
      "label" : "CoGuard Organization",
      "description" : "The CoGuard organization the scans belong to, as it appears in the address of the CoGuard portal (https://portal.coguard.io/orgs/<organization>/...). The scans go into it, and the CoGuard Report link of the role points into it.",
      "configName" : "coguard_organization",
      "type" : "string",
      "required" : "true"
    },
    {
      "name" : "coguard_cluster_name",
      "label" : "CoGuard Cluster Name",
      "description" : "The name of this cluster in the CoGuard portal, which is the name of the cluster in Cloudera Manager with every character other than a letter or a digit replaced by an underscore: ozone-base-cluster is ozone_base_cluster. It completes the CoGuard Report link of the role. The role checks it against the name the scan actually uses, and says in its log what to set if the two differ.",
      "configName" : "coguard_cluster_name",
      "type" : "string",
      "required" : "true"
    },
    {
      "name" : "coguard_api_url",
      "label" : "CoGuard API URL",
      "description" : "The API of the CoGuard instance the scans go to, e.g. https://coguard.example.com/server. Leave empty for CoGuard's public instance (https://portal.coguard.io/server). For a CoGuard instance of your own, set the CoGuard Authentication URL and the CoGuard Portal Address to that instance as well.",
      "configName" : "coguard_api_url",
      "type" : "string",
      "default" : ""
    },
    {
      "name" : "coguard_auth_url",
      "label" : "CoGuard Authentication URL",
      "description" : "The authentication server of the CoGuard instance, which the CoGuard User and Password log in to, e.g. https://coguard.example.com/auth. Leave empty for CoGuard's public instance (https://portal.coguard.io/auth).",
      "configName" : "coguard_auth_url",
      "type" : "string",
      "default" : ""
    },
    {
      "name" : "environment_file",
      "label" : "Credentials File",
      "description" : "Optional. A file on the host of the Configuration Check role with any of CLOUDERA_MANAGER_PASSWORD, COGUARD_USER_NAME, COGUARD_PASSWORD and COGUARD_ORGANIZATION as KEY=value lines, for credentials which are delivered to the host by other means, such as a configuration management tool or a secrets agent. A value in the file takes precedence over the parameter of the same meaning. It has to be readable by the user this service runs as. Leave empty to use the parameters above only.",
      "configName" : "environment_file",
      "type" : "string",
      "default" : ""
    },
    {
      "name" : "cloudera_manager_ca_cert",
      "label" : "CA Certificate Bundle",
      "description" : "The path to a CA certificate bundle to trust when connecting to Cloudera Manager, such as the cm-auto-global_cacerts.pem of Auto-TLS. Leave empty to use the trust store of the host. The certificate of Cloudera Manager is always verified.",
      "configName" : "cloudera_manager_ca_cert",
      "type" : "string",
      "default" : ""
    },
    {
      "name" : "cloudera_cluster",
      "label" : "Cluster",
      "description" : "The name of the cluster to scan. Only needed if this Cloudera Manager manages more than one cluster.",
      "configName" : "cloudera_cluster",
      "type" : "string",
      "default" : ""
    },
    {
      "name" : "minimum_fail_level",
      "label" : "Minimum Severity",
      "description" : "The lowest severity of a finding which makes this service unhealthy. Severities run from 1 to 5; 4 and 5 are the High and Critical findings, which is the default, so that this service is unhealthy while one of those is not addressed. Lower it to 1 to be told about every finding. Findings below it still appear in the report and in the banner.",
      "configName" : "minimum_fail_level",
      "type" : "long",
      "default" : 4,
      "min" : 1,
      "max" : 5
    },
    {
      "name" : "ruleset",
      "label" : "Compliance Rule Set",
      "description" : "The compliance rule set to scan against, e.g. nist800-53. Requires an enterprise subscription. Leave empty to scan against the ordinary rules.",
      "configName" : "ruleset",
      "type" : "string",
      "default" : ""
    },
    {
      "name" : "report_url",
      "label" : "CoGuard Portal Address",
      "description" : "The address of the CoGuard portal, without a trailing slash; for a CoGuard instance of your own, the address of its portal. The CoGuard Report link of the role is this address followed by /orgs/<CoGuard Organization>/<CoGuard Cluster Name>, i.e. the report of this cluster, since the health test itself can only say that there are findings, not which.",
      "configName" : "report_url",
      "type" : "uri",
      "default" : "https://portal.coguard.io"
    }
  ],
  "roles" : [
    {
      "name" : "CONFIGURATION_CHECK",
      "label" : "CoGuard Configuration Check",
      "pluralLabel" : "CoGuard Configuration Checks",
      "startRunner" : {
        "program" : "scripts/control.sh",
        "args" : [ "start" ],
        "environmentVariables" : {
          "CLOUDERA_MANAGER_URL" : "${cloudera_manager_url}",
          "CLOUDERA_MANAGER_USER" : "${cloudera_manager_user}",
          "CLOUDERA_MANAGER_CA_CERT" : "${cloudera_manager_ca_cert}",
          "CLOUDERA_CLUSTER" : "${cloudera_cluster}",
          "ENVIRONMENT_FILE" : "${environment_file}",
          "CLOUDERA_MANAGER_PASSWORD" : "${cloudera_manager_password}",
          "COGUARD_USER_NAME" : "${coguard_user_name}",
          "COGUARD_PASSWORD" : "${coguard_password}",
          "COGUARD_ORGANIZATION" : "${coguard_organization}",
          "COGUARD_CLUSTER_NAME" : "${coguard_cluster_name}",
          "REPORT_URL" : "${report_url}",
          "LOG_DIR" : "${log_dir}",
          "COGUARD_API_URL" : "${coguard_api_url}",
          "COGUARD_AUTH_URL" : "${coguard_auth_url}",
          "MINIMUM_FAIL_LEVEL" : "${minimum_fail_level}",
          "RULESET" : "${ruleset}",
          "WORK_DIRECTORY" : "${work_directory}",
          "CHECK_INTERVAL_SECONDS" : "${check_interval_seconds}",
          "MINIMUM_SCAN_INTERVAL_SECONDS" : "${minimum_scan_interval_seconds}",
          "MAXIMUM_SCAN_AGE_SECONDS" : "${maximum_scan_age_seconds}",
          "ERROR_TOLERANCE" : "${error_tolerance}"
        }
      },
      "topology" : {
        "minInstances" : 1,
        "maxInstances" : 1
      },
      "healthAggregation" : {
        "type" : "singleton"
      },
      "logging" : {
        "dir" : "/var/log/configuration-assurance",
        "filename" : "coguard-report.md",
        "configName" : "log_dir",
        "loggingType" : "other"
      },
      "externalLink" : {
        "name" : "configuration_report",
        "label" : "CoGuard Report",
        "url" : "${report_url}/orgs/${coguard_organization}/${coguard_cluster_name}"
      },
      "parameters" : [
        {
          "name" : "work_directory",
          "label" : "Working Directory",
          "description" : "Where the scan result and the position in the event feed of Cloudera Manager are kept between checks. It has to survive a restart of the role, which is why it is not the process directory Cloudera Manager creates.",
          "configName" : "work_directory",
          "type" : "string",
          "default" : "/var/lib/coguard",
          "required" : "true"
        },
        {
          "name" : "check_interval_seconds",
          "label" : "Check Interval",
          "description" : "How long the role waits between two checks of whether the configuration of the cluster has changed. A check without a change costs one API request per watched event code and does not scan.",
          "configName" : "check_interval_seconds",
          "type" : "long",
          "default" : 900,
          "min" : 60,
          "unit" : "seconds"
        },
        {
          "name" : "minimum_scan_interval_seconds",
          "label" : "Minimum Scan Interval",
          "description" : "The shortest distance between two scans, so that a rolling restart of the cluster does not result in a scan per service. It does not apply to the first check after this role is started: starting or restarting the role is a request for a fresh scan.",
          "configName" : "minimum_scan_interval_seconds",
          "type" : "long",
          "default" : 900,
          "min" : 0,
          "unit" : "seconds"
        },
        {
          "name" : "maximum_scan_age_seconds",
          "label" : "Maximum Scan Age",
          "description" : "A scan is run after this long even though no event reported a change, which bounds how out of date the health of this service can be. The event feed is a hint and not a guarantee: events are retained for a finite time, the Event Server can be down, and CoGuard adds rules over time.",
          "configName" : "maximum_scan_age_seconds",
          "type" : "long",
          "default" : 86400,
          "min" : 0,
          "unit" : "seconds"
        },
        {
          "name" : "error_tolerance",
          "label" : "Tolerated Consecutive Failures",
          "description" : "How many checks in a row may fail before this role reports itself unhealthy. A failure here means the check could not be performed at all -- Cloudera Manager could not be read, or the CoGuard CLI could not be run -- which is not the same thing as a cluster with findings, but is not something to stay silent about either.",
          "configName" : "error_tolerance",
          "type" : "long",
          "default" : 3,
          "min" : 1
        }
      ]
    }
  ]
}
